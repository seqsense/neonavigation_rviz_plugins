<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>trajectory_tracker_rviz_plugins</name>
  <version>0.17.1</version>
  <description>RViz plugins for trajectory_tracker_msgs</description>
  <maintainer email="atsushi.w@ieee.org">Atsushi Watanabe</maintainer>
  <license>BSD</license>
  <license>Creative Commons</license>
  <author email="atsushi.w@ieee.org">Atsushi Watanabe</author>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <build_depend>qtbase5-dev</build_depend>

  <!-- Pulled in by rviz_common's MessageFilterDisplay, which instantiates
       message_filters::Subscriber and tf2_ros::MessageFilter in this package. -->
  <depend>message_filters</depend>
  <depend>pluginlib</depend>
  <depend>rviz_common</depend>
  <depend>rviz_ogre_vendor</depend>
  <depend>rviz_rendering</depend>
  <depend>tf2_ros</depend>
  <depend>trajectory_tracker_msgs</depend>

  <exec_depend>libqt5-core</exec_depend>
  <exec_depend>libqt5-gui</exec_depend>
  <exec_depend>libqt5-widgets</exec_depend>

  <test_depend>ament_cmake_clang_format</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
